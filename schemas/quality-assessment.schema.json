{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bradgeigermanager-sketch.github.io/Support-Opportunity-Atlas/schemas/quality-assessment.schema.json",
  "title": "Support Opportunity Atlas Quality Assessment",
  "description": "A versioned, dimension-level assessment of the quality and permitted use of a need, opportunity, resource, organization, or recommendation record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quality_assessment_id",
    "subject_type",
    "subject_id",
    "assessment_version",
    "assessed_at",
    "assessor",
    "dimensions",
    "issues",
    "permitted_use",
    "review_status",
    "ruleset_reference"
  ],
  "properties": {
    "quality_assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_type": {
      "enum": [
        "need",
        "opportunity",
        "resource",
        "organization",
        "person",
        "project",
        "contribution",
        "recommendation",
        "relationship",
        "other"
      ]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "assessment_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "automated_rule_set",
            "human_reviewer",
            "hybrid_process",
            "external_assessor"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "validity",
        "accuracy",
        "freshness",
        "provenance",
        "consistency",
        "relevance",
        "accessibility",
        "fairness",
        "actionability"
      ],
      "properties": {
        "completeness": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        },
        "validity": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        },
        "accuracy": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        },
        "freshness": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        },
        "provenance": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        },
        "consistency": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        },
        "relevance": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        },
        "accessibility": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        },
        "fairness": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        },
        "actionability": {
          "enum": [
            "pass",
            "warning",
            "fail",
            "not_assessed"
          ]
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "major",
              "critical"
            ]
          },
          "field": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_action": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "permitted_use": {
      "enum": [
        "discovery_only",
        "provisional_matching",
        "review_required",
        "operational_use",
        "restricted",
        "not_permitted"
      ]
    },
    "review_status": {
      "enum": [
        "not_required",
        "queued",
        "in_review",
        "needs_information",
        "resolved",
        "escalated",
        "appealed"
      ]
    },
    "ruleset_reference": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes_assessment_id": {
      "type": "string"
    }
  }
}
