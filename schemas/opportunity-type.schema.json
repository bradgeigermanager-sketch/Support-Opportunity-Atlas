{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bradgeigermanager-sketch.github.io/Support-Opportunity-Atlas/schemas/opportunity-type.schema.json",
  "title": "Opportunity Type Term",
  "description": "A governed vocabulary term describing an opportunity mechanism, not a live listing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "term_id",
    "preferred_label",
    "definition",
    "taxonomy",
    "status",
    "version"
  ],
  "properties": {
    "term_id": {
      "type": "string",
      "pattern": "^opp\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "preferred_label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "definition": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1200
    },
    "taxonomy": {
      "const": "opportunity_type"
    },
    "parent_term_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "label"
        ],
        "properties": {
          "language": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "replaced_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
